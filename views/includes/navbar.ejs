<style>
  .btn-search {
    background-color: #fe424d;
    color: white;
    border-radius: 25rem;
    padding: 0 1rem 0 1 rem;
  }
  .btn-search {
  display: inline;
  white-space: nowrap;
  }
  .search-input {
     border-radius: 25rem;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }
  .btn-search {
    white-space: nowrap;
}

.navbar select {
    min-width: 160px;
}

</style>


<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top"> 
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler"
     type="button"
      data-bs-toggle="collapse"
       data-bs-target="#navbarNavAltMarkup"
        aria-controls="navbarNavAltMarkup"
         aria-expanded="false" 
         aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <!-- <a class="nav-link "  href="/">Home</a> -->
        <a class="nav-link" href="/listings">Explore</a>
        
      </div>

      <div class="navbar-nav ms-auto">

    <form
        class="d-flex align-items-center gap-2"
        action="/listings/search"
        method="GET"
    >

        <!-- COUNTRY -->
        <select
            class="form-select search-input"
            name="country"
            id="countrySelect"
        >
            <option value="">
                Select Country
            </option>

            <% for(let country of searchCountries) { %>

                <option value="<%= country %>">
                    <%= country %>
                </option>

            <% } %>

        </select>


        <!-- LOCATION -->
        <select
            class="form-select search-input"
            name="location"
            id="locationSelect"
            disabled
        >
            <option value="">
                Select Location
            </option>
        </select>


        <button
            class="btn btn-search"
            type="submit"
        >
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
        </button>

    </form>

</div>

      <!-- showing signup,login and logout option on navbar -->
       <div class="navbar-nav ms-auto">
          <a class="nav-link" href="/listings/new">Add new Listing</a>
        <!-- if signuped and logged in -->
        <% if(!curruser){%>
        <a class="nav-link "  href="/signup"><b>SignUp</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <%}%>
        <!-- if not logedin -->
         <% if(curruser){%>
        <a class="nav-link" href="/logout"><b>Logout</b></a>
         <%}%>
      </div>
    </div>
  </div>
</nav>


<!-- after selecting country initially location disabled hi -->
<script>

const countrySelect = document.getElementById("countrySelect");
const locationSelect = document.getElementById("locationSelect");

countrySelect.addEventListener("change", async function () {

    const country = this.value;

    // purani location remove
    locationSelect.innerHTML =
        '<option value="">Select Location</option>';

    // agar country select nahi hai
    if (!country) {
        locationSelect.disabled = true;
        return;
    }

    // selected country ki locations server se lao
    const response = await fetch(
        `/listings/locations/${encodeURIComponent(country)}`
    );

    const locations = await response.json();

    // dropdown me location add karo
    for (let location of locations) {

        const option = document.createElement("option");

        option.value = location;
        option.textContent = location;

        locationSelect.appendChild(option);
    }

    locationSelect.disabled = false;

});

</script>