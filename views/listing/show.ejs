<%layout("/layouts/boilerplate")%>
<body>
   <!-- Agar map.js me ye code hai:
let mapToken = "<%= process.env.MAP_TOKEN %>";
to ye problem karega, kyunki map.js ek static JavaScript file hai. EJS uske andar <%= %> process nahi karta. -->
    <script>
        const mapToken="<%=process.env.MAP_TOKEN%>";
         const listing = <%-JSON.stringify(listing) %>;
    </script>
 <div class="row mt-3">
        <div class="col-8 offset-3 ">
    <h3>Listing Details</h3>
    </div>
     <div class="col-6 offset-3">
    <div class="card listing-card" >
    <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="Listing image">
    <div class="card-body">
   
        <p class="card-text" ><i>ownedby <%=listing.owner.username%></i></p>
       <p class="card-text"> <%=listing.title%> </p>
        <p class="card-text"><%=listing.description%></p>
       <p class="card-text"></p> &#8377; <%=listing.price.toLocaleString("en-IN")%>
       <p class="card-text"><%=listing.location%></p>
        <p class="card-text"><%=listing.country%></p>

  </div>
  </div>
<!-- edit and delete is done is ownerid and loggedin user id same hoga -->
 <% if(curruser && curruser._id.equals(listing.owner._id)) {%>
 <div class="btns col-3 offset-3 show-btn">
              <a href="/listings/<%=listing._id%>/edit" class="btn edit-btn offset-3 ">Edit </a>
              <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
               <button class="btn btn-dark offset-2">Delete </button>
              </form>
    </div>
<%}%>

    <br>
</div>
</div>

<!-- reviews section -->
 <div class="col-8 offset-3 mb-3">
    <hr>
        <% if(curruser){%>
        <h4>Leave a review</h4>
        <!-- nonvalidate class ="needs-validation" if some error then error display using boostrape -->
    <form  method="POST" 
    action="/listings/<%=listing._id%>/reviews" 
    novalidate class="needs-validation">

        <!-- <div class="mb-3 mt-3">
            <label for="rating" class="form-level">Rating</label>
            <input type="range"
            min="1"
            max="5"
            id="disabledRange"
            name="review[rating]" 
            class="form-range">
        </div> -->
        <div class="mb-3 mt-3">
             <label for="rating" class="form-level">Rating</label>
<fieldset class="starability-slot">
  <legend>First rating:</legend>
  <input type="radio" 
  id="no-rate"
  class="input-no-rate" 
  name="review[rating]" 
  value="1"
  checked 
  aria-label="No rating."
    />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
   </div>
        <div class="mt-3" >
        <label for="comment" class="form-label">Comments</label>
        <textarea
            name="review[comment]"
            id="comment"
            class="form-control"
            rows="4"
            placeholder="Write your review here..."
            required></textarea>
            <!-- if comment is not filled this is error  shown display -->
         <div class="invalid-feedback">
        please add some comment for review
      </div>
    </div>
    <br>
    <button type="submit" class="btn btn-danger mt-3">
        Submit Review
    </button>
    </form>
    <hr>
    <%}%> 

    <!--showing review on each listing using bootstap -->
   <% if(listing.reviews.length>0){%>
    <h4>All Reviews</h4>
<div class="row">
    <% listing.reviews.forEach(review => { %>

        <div class="col-md-6 mb-3">
            <div class="card ">
                <div class="card-body">
                    <h5 class="card-title"><i>@</i><%=review.author.username %></h5>

                    <p class="starability-result card-text" data-rating="<%= review.rating %>">

                    </p>
                    <p class="card-text">
                        <%= review.comment %>
                    </p>

    
                    

                    <form class="mb-3" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                </div>
            </div>
        </div>

    <% }) %>

    
</div>  
<%}%>
<!-- map set up -->
<div class="mb-3 mt-3" >
    <h3>Where you will be</h3>
    <div id="map"></div>
</div>
<!-- access js code which is in map.js in public folder -->
<script src="/js/map.js"></script>

 </div>
</body>



   