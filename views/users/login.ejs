<%layout("/layouts/boilerplate")%>
<body>
    
<div class="row mt-3">
    <h1 class="col-8 offset-3">Login</h1>
        <div class="col-8 offset-3 ">
            <form action="/login" method="POST" novalidate class="needs-validation">

        <!-- for username -->
         <div  class="mb-3">
            <label for="username" class="form-label">username</label>
            <input name="username"
            id ="username"
             type="text"
              class="form-control"
              required
              />
        </div>

         <!-- email enter nhi kara raha hu  -->

        <!-- for password -->
         <div  class="mb-3">
            <label for="password" class="form-label">password</label>
            <input name="password"
            id ="password"
             type="text"
              class="form-control"
              required
              />
        </div>

        <button class="btn btn-success">
            Login
        </button>
            </form>
        </div>
</div>

 